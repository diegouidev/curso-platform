# Produção (VPS + Cloudflare Tunnel). Copie para .env na VPS e preencha:
#   cp .env.production.example .env
# Passo a passo completo em docs/deploy.md.

# --- Django ------------------------------------------------------------------
# Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ADMIN_ENABLED=false
LOG_LEVEL=INFO

# --- Criptografia dos tokens do Google ----------------------------------------
# Trazendo o banco da instalação antiga? Use A MESMA chave de lá (senão é preciso
# reconectar o Google). Instalação nova: gere uma (veja o .env.example).
FIELD_ENCRYPTION_KEY=

# --- Endereço público --------------------------------------------------------------
FRONTEND_URL=https://cursos.diegodev.app.br
# Porta local (só 127.0.0.1) que o cloudflared acessa. Mude se já estiver em uso.
APP_PORT=3100

# --- Sessão (JWT) -------------------------------------------------------------------
JWT_ACCESS_MINUTES=5
JWT_REFRESH_DAYS=7
# HTTPS (Cloudflare): o cookie de sessão só trafega criptografado.
AUTH_COOKIE_SECURE=true
LOGIN_THROTTLE_RATE=10/min

# --- Google OAuth (veja docs/google-oauth.md) ----------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Precisa estar cadastrado na credencial OAuth do Google Cloud.
GOOGLE_REDIRECT_URI=https://cursos.diegodev.app.br/api/google/callback

# --- Importação ---------------------------------------------------------------------
COURSE_IMPORT_ASYNC=true
