# Copie para .env (cp .env.example .env) e preencha. O .env nunca vai para o git.
# Lido pelo Django (rodando local ou no Docker) e pelo docker-compose.

# --- Django ------------------------------------------------------------------
# Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Habilita /admin (padrão: igual a DJANGO_DEBUG)
DJANGO_ADMIN_ENABLED=true
LOG_LEVEL=INFO

# Onde ficam o SQLite e os uploads (capas). No Docker é sobrescrito para /data (volume).
DATA_DIR=./backend/data
# Opcional: PostgreSQL em vez de SQLite
# DATABASE_URL=postgres://user:password@localhost:5432/curso_platform

# --- Criptografia dos tokens do Google ----------------------------------------
# Gere com: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Para rotacionar: NOVA_CHAVE,CHAVE_ANTIGA (a primeira criptografa, todas descriptografam)
FIELD_ENCRYPTION_KEY=

# --- Frontend / CORS ------------------------------------------------------------
# URL pública do frontend (redirect após o OAuth, CORS e CSRF)
FRONTEND_URL=http://localhost:3000
# URL do backend vista pelo servidor Next.js (proxy de /api/*).
# Local: http://localhost:8000 · Docker: http://backend:8000 (definido no compose)
BACKEND_URL=http://localhost:8000

# --- Sessão (JWT) -----------------------------------------------------------------
JWT_ACCESS_MINUTES=5
JWT_REFRESH_DAYS=7
# Cookie do refresh só via HTTPS. Use false em http://localhost.
AUTH_COOKIE_SECURE=false
LOGIN_THROTTLE_RATE=10/min

# --- Google OAuth (Fase 2; veja docs/google-oauth.md) -----------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/google/callback

# --- Importação ---------------------------------------------------------------------
# false = importa de forma síncrona dentro da requisição (útil para depurar)
COURSE_IMPORT_ASYNC=true
